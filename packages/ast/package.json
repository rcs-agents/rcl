  },
  "dependencies": {},
  "devDependencies": {
    "@types/minimatch": "^6.0.0",
    "@types/node": "^24.0.13",
    "typescript": "^5.0.0"
  },
  "files": [
    "dist/**/*"
  ],
  "publishConfig": {
    "access": "public"
  }
}